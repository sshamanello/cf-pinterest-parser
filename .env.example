# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here
CF_AFFILIATE_ID=your_cf_affiliate_id_here
GOOGLE_CREDENTIALS_PATH=credentials.json

# Scraping
PAGES_PER_RUN=3

# ComfyUI (опционально — если не запущен, используется Pillow-only режим)
COMFY_URL=http://127.0.0.1:8188
COMFY_MODEL=realisticVisionV51.safetensors
COMFY_DENOISE=0.50
COMFY_STEPS=20
COMFY_CFG=7.0

# VDS upload for autonomous n8n publishing
VDS_SSH_HOST=your_vds_host
VDS_SSH_USER=your_vds_user
VDS_SSH_PORT=22
VDS_SSH_PASSWORD=
VDS_REMOTE_DIR=/var/www/pins/ready
VDS_PUBLIC_BASE_URL=https://your-domain.com/pins/ready
