# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here
CF_AFFILIATE_ID=7029352
GOOGLE_CREDENTIALS_PATH=credentials.json
# Optional alternative for CI/Docker secrets injection:
# GOOGLE_CREDENTIALS={...json...}

# Scraping and batching
PAGES_PER_RUN=3

# ComfyUI (optional; if unavailable the project falls back to script-only processing)
COMFY_URL=http://127.0.0.1:8188
COMFY_MODEL=realisticVisionV51.safetensors
COMFY_DENOISE=0.50
COMFY_STEPS=20
COMFY_CFG=7.0

# VDS upload for autonomous publishing
VDS_SSH_HOST=your_vds_host
VDS_SSH_USER=your_vds_user
VDS_SSH_PORT=22
VDS_SSH_PASSWORD=
VDS_REMOTE_DIR=/var/www/html/pins/ready
VDS_PUBLIC_BASE_URL=https://your-domain.example/pins/ready

# Phone automation
PHONE_ACCOUNTS={"SERIAL":"pinterest_account_name"}

# Logging
CF_LOG_LEVEL=INFO
CF_LOG_DIR=logs
CF_LOG_MAX_BYTES=5242880
CF_LOG_BACKUP_COUNT=5

# Docker cron service defaults (high-throughput mode)
CF_CRON_SCHEDULE=10 * * * *
CF_RUN_COMMAND=python run.py prod-auto-pin --niche fonts --pages 100 --limit 120 --output output/docker_prod --upload-vds --sync-sheet
CF_PAGE_CURSOR_MAX=1000
CF_ADAPTIVE_ENABLED=true
CF_ADAPTIVE_TARGET_NEW=50
CF_ADAPTIVE_MAX_PAGES_PER_RUN=300
