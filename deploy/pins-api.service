[Unit]
Description=Transient pin upload API for CF Pinterest
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/opt/caddy/.env
Environment=PINS_API_ROOT_DIR=/opt/caddy/html/pins/ready
Environment=PINS_API_HOST=0.0.0.0
Environment=PINS_API_PORT=8877
ExecStart=/usr/bin/python3 /opt/caddy/pins_api.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
