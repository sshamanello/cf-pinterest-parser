    {
      "parameters": {
        "jsCode": "const MIN_AGE_MS = 30 * 60 * 1000;\nconst now = Date.now();\n\nconst rows = items.filter((item) => {\n  const row = item.json;\n  const cleanup = String(row.cleanup_status ?? '').trim().toLowerCase();\n  const status = String(row.publish_status ?? '').trim().toLowerCase();\n  const publishedAt = Date.parse(row.published_at || row.uploaded_at || '');\n  const oldEnough = Number.isNaN(publishedAt) || (now - publishedAt >= MIN_AGE_MS);\n\n  return status === 'published'\n    && cleanup !== 'deleted'\n    && Boolean(row.slug)\n    && oldEnough;\n});\n\nreturn rows.slice(0, 10);\n"
      },
      "id": "1bde73d4-19c9-498f-8506-790e9d617339",
