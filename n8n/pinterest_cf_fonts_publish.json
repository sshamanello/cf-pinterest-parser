    {
      "parameters": {
        "jsCode": "const ready = items.filter((item) => {\n  const row = item.json;\n  const posted = String(row.posted ?? '').trim().toUpperCase();\n  const status = String(row.publish_status ?? '').trim().toLowerCase();\n  const upload = String(row.vds_upload_status ?? '').trim().toLowerCase();\n  return status === 'ready'\n    && posted !== 'TRUE'\n    && upload === 'uploaded'\n    && Boolean(row.public_image_url)\n    && Boolean(row.affiliate_url)\n    && Boolean(row.slug);\n});\n\nreturn ready.slice(0, 1);\n"
      },
      "id": "af1ce29c-55bb-4188-b185-a4ae53b39c25",
