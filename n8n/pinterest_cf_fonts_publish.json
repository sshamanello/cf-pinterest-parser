  "nodes": [
    {
      "parameters": {
        "content": "## CF fonts: публикация\nБерёт первую строку fonts, где publish_status=ready, есть локальный обработанный файл в pin_path, vds_upload_status=uploaded и posted не TRUE. n8n читает локальный JPG, грузит один transient pin.jpg на VDS API, публикует pin и потом cleanup удаляет файл.",
        "height": 220,
        "width": 360
      },
      "id": "baa44431-c59b-4f96-8820-0292bf6f4316",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 5,
              "triggerAtMinute": 15
            }
          ]
        }
      },
      "id": "7f7d18aa-afa2-459d-bc6b-1331e32642d1",
      "name": "Every 5 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        464
      ],
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT f.* FROM fonts f JOIN available_pin_paths app ON app.pin_path = f.pin_path WHERE f.publish_status = 'ready' AND upper(coalesce(f.posted, '')) <> 'TRUE' AND lower(coalesce(f.vds_upload_status, '')) = 'uploaded' AND coalesce(f.affiliate_url, '') <> '' AND coalesce(f.slug, '') <> '' AND coalesce(f.pin_path, '') <> '' ORDER BY f.id LIMIT 1;",
        "options": {}
      },
      "id": "a54ff762-e742-45c8-be67-286f0b11144d",
      "name": "Get ready rows",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        384
      ],
      "credentials": {
        "postgres": {
          "id": "PgLocalCred2026A1",
          "name": "Postgres Pinterest Local"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ready = items.filter((item) => {\n  const row = item.json;\n  const posted = String(row.posted ?? '').trim().toUpperCase();\n  const status = String(row.publish_status ?? '').trim().toLowerCase();\n  const upload = String(row.vds_upload_status ?? '').trim().toLowerCase();\n  return status === 'ready'\n    && posted !== 'TRUE'\n    && upload === 'uploaded'\n    && Boolean(row.pin_path)\n    && Boolean(row.affiliate_url)\n    && Boolean(row.slug);\n});\n\nreturn ready.slice(0, 1);\n"
      },
      "id": "451a8bc3-e843-4b80-939d-fe754a123321",
      "name": "Pick one publishable row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        384
      ]
    },
    {
      "parameters": {
        "fileSelector": "={{ \"/home/nick/cf-pinterest-parser/\" + $json.pin_path }}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "id": "4914913e-97f9-4c32-bf25-c96d62650f15",
      "name": "Read image file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        624,
        384
      ]
    },
    {
      "parameters": {
        "mode": "binaryToJson",
        "setAllData": false,
        "sourceKey": "data",
        "destinationKey": "image_base64",
        "options": {
          "keepAsBase64": true,
          "keepSource": false
        }
      },
      "id": "a7a0bf8a-3a19-4c34-8a68-8a8c9d0f1b11",
      "name": "Convert image to base64",
      "type": "n8n-nodes-base.moveBinaryData",
      "typeVersion": 1.1,
      "position": [
        800,
        384
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.pinterest.com/v5/pins",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "pinInterestOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  board_id: \"905716243751342067\",\n  title: ((($('Pick one publishable row').item.json.title || $('Pick one publishable row').item.json.slug || \"Beautiful Font\") + \" Font for Cricut, Stickers & DIY Crafts\").toString().slice(0, 90)),\n  description: ((($('Pick one publishable row').item.json.hook_text ? $('Pick one publishable row').item.json.hook_text + \". \" : \"\") + \"Discover \" + ($('Pick one publishable row').item.json.title || $('Pick one publishable row').item.json.slug || \"this font\") + \" for Cricut projects, SVG designs, sublimation, printables, branding, invitations, stickers, logo design and creative business products. Save this pin for font inspiration and open the link to view the full preview and download page.\").slice(0, 500)),\n  link: $('Pick one publishable row').item.json.affiliate_url,\n  media_source: {\n    source_type: \"image_base64\",\n    content_type: \"image/jpeg\",\n    data: $json.image_base64\n  }\n}) }}",
        "options": {}
      },
      "id": "359c740e-a4c2-4813-b909-c4b43d333d47",
      "name": "Create Pinterest pin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        384
      ],
      "credentials": {
        "pinInterestOAuth2Api": {
          "id": "F0pxjtQAV06pJuzo",
          "name": "InkMint"
        }
      },
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "no_error",
              "leftValue": "={{ $json.error?.message || $json.error || \"\" }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "73cf5266-75ce-4582-88a5-8a607bdee91a",
      "name": "Pinterest success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        976,
        384
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE fonts SET posted='TRUE',     publish_status='published',     pin_id='{{ $json.id || $json.pin_id || $json.pinId || $json.data?.id || '' }}',     published_at='{{ $now }}',     error_reason='' WHERE slug='{{ $('Pick one publishable row').item.json.slug }}' RETURNING *;",
        "options": {}
      },
      "id": "5561936f-0708-4b3b-b994-fd1d61a1d4e4",
      "name": "Mark row published",
