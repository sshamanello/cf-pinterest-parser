        "pinDescription": "={{ (($json.hook_text ? $json.hook_text + '. ' : '') + 'Explore this font for Cricut, crafts, branding, printable designs and creative projects.').slice(0, 450) }}",
        "pinLink": "={{ $json.affiliate_url }}",
        "imageUrl": "={{ $json.public_image_url }}"
